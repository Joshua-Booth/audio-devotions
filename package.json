{
  "name": "audio-devotions",
  "type": "module",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest",
    "test:storybook": "vitest --project=storybook",
    "test:unit": "vitest --project=unit",
    "test:ui": "vitest --ui",
    "lint": "oxlint --fix",
    "lint:check": "oxlint --max-warnings 0",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "knip": "knip --no-config-hints",
    "audit": "pnpm audit --audit-level=high",
    "spell": "cspell .",
    "prepare": "lefthook install --reset-hooks-path",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.15.0",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@stylexjs/stylex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-player": "^3.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@stylexjs/unplugin": "^0.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "^5.0.5",
    "cspell": "^10.4.0",
    "knip": "^6.43.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "playwright": "^1.64.1",
    "storybook": "^10.6.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
