{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":maintainLockFilesMonthly",
    "schedule:monthly",
    "group:allNonMajor"
  ],

  "labels": ["dependencies"],
  "baseBranchPatterns": ["master"],
  "minimumReleaseAge": "3 days",

  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "commitMessageAction": "update",

  "packageRules": [
    {
      "description": "Automerge non-major updates for stable packages",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Require manual review for major updates",
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Require review for 0.x packages",
      "matchCurrentVersion": "/^0/",
      "labels": ["dependencies", "unstable"]
    },
    {
      "description": "Group StyleX packages (the runtime and compiler share a version)",
      "matchPackageNames": ["/^@stylexjs\\//"],
      "groupName": "stylex"
    },
    {
      "description": "TypeScript 7 has no JavaScript API, which Storybook and commitlint need",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ],

  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "schedule": ["at any time"],
    "minimumReleaseAge": "3 days"
  }
}
